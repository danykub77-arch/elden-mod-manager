{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elden-mod-manager",
  "version": "0.1.7",
  "identifier": "com.danykub.eldenmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "elden-mod-manager",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDRkU5ODcyOEM5QUZBQjcKUldTMytwcU1jcGorN0FoYXY4MEwzbC9oOFpEa1ZlOHJGRHpDbkUza3NvNW5iWUpUZFhCeU1aMWwK",
      "endpoints": [
        "https://github.com/danykub77-arch/elden-mod-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
